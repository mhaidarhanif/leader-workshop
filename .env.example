# Postgres (local: docker compose up -d; prod: Railway injects DATABASE_URL)
POSTGRES_HOST=localhost
POSTGRES_USER=leader_user
POSTGRES_PASSWORD=leader_password
POSTGRES_DB=leader_db

# Optional override — Railway sets this in prod; leave unset for local dev
DATABASE_URL=postgresql://leader_user:leader_password@localhost:5433/leader_db

# Shared PIN for /judge scoring (required)
JUDGE_PIN=leader_pin

# Server port (Railway sets PORT automatically; default 3000 locally)
PORT=3000
